# Copy to .env and adjust. Every setting in src/paragraf/config.py can be overridden here.
PARAGRAF_DATABASE_URL=postgresql://paragraf:paragraf@localhost:5432/paragraf
# qwen2.5:14b (default, best quality) or qwen2.5:7b for machines with < 16 GB RAM (about 2x faster)
PARAGRAF_LLM_MODEL=qwen2.5:14b
PARAGRAF_DEVICE=mps
# Optional: hosted judge for the evaluation (eval/judge.py --judge haiku). Never commit the real key.
PARAGRAF_ANTHROPIC_API_KEY=
